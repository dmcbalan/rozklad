rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isTeacher() {
      return request.auth != null && request.auth.token.email == 'ikramoonfeyx@gmail.com';
    }
    // Постійний розклад і разові зміни (переноси, відпрацювання) бачать усі
    match /lessons/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    match /changes/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // Особиста сторінка учня: прочитати можна лише знаючи код, переглянути список не можна
    match /public/{token} {
      allow get: if true;
      allow list, write: if isTeacher();
      // Фото учня: додати може лише той, хто має посилання на існуючу сторінку
      match /photos/{id} {
        allow read: if true;
        allow create: if exists(/databases/$(db)/documents/public/$(token))
          && request.resource.data.keys().hasOnly(['caption', 'created'])
          && request.resource.data.caption is string && request.resource.data.caption.size() <= 200
          && request.resource.data.created == request.time;
        allow delete: if isTeacher();
      }
      match /photoData/{id} {
        allow read: if true;
        allow create: if exists(/databases/$(db)/documents/public/$(token))
          && request.resource.data.keys().hasOnly(['image'])
          && request.resource.data.image is string && request.resource.data.image.size() < 700000;
        allow delete: if isTeacher();
      }
      // Чат: учень пише зі своєї сторінки (знаючи код), від імені викладача — лише викладач
      match /messages/{id} {
        allow read: if true;
        allow create: if exists(/databases/$(db)/documents/public/$(token))
          && request.resource.data.keys().hasOnly(['by', 'text', 'created', 'kind', 'name', 'file'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          // вкладення: kind + name + file (id документа в msgData); без вкладення текст обов'язковий
          && request.resource.data.get('kind', '') in ['', 'image', 'file', 'voice']
          && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 200
          && request.resource.data.get('file', '') is string && request.resource.data.get('file', '').size() <= 40
          && (request.resource.data.get('kind', '') == '' ? request.resource.data.text.size() > 0 : request.resource.data.get('file', '').size() > 0)
          && request.resource.data.created == request.time
          && (request.resource.data.by == 'student' || (request.resource.data.by == 'teacher' && isTeacher()));
        // скасувати повідомлення: учень — свої, викладач — будь-які
        allow delete: if isTeacher() || resource.data.by == 'student';
      }
      // Дані вкладень чату (фото, файли, голосові) — окремо, щоб список повідомлень був легким
      match /msgData/{id} {
        allow read: if true;
        allow create: if exists(/databases/$(db)/documents/public/$(token))
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string && request.resource.data.data.size() < 900000;
        allow delete: if isTeacher() || exists(/databases/$(db)/documents/public/$(token));
      }
      // Сповіщення учню пише лише викладач
      match /notifs/{id} {
        allow read: if true;
        allow create, delete: if isTeacher();
      }
      // Здане ДЗ: учень створює зі статусом 'new', перевіряє (змінює статус) лише викладач
      match /subs/{id} {
        allow read: if true;
        allow create: if exists(/databases/$(db)/documents/public/$(token))
          && request.resource.data.keys().hasOnly(['hw', 'text', 'link', 'file', 'status', 'created'])
          && request.resource.data.hw is string && request.resource.data.hw.size() == 10
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && request.resource.data.link is string && request.resource.data.link.size() <= 500
          && (request.resource.data.link == '' || request.resource.data.link.matches('https?://.+'))
          && request.resource.data.file is string && request.resource.data.file.size() <= 200
          && request.resource.data.status == 'new'
          && request.resource.data.created == request.time;
        allow update, delete: if isTeacher();
      }
      match /subData/{id} {
        allow read: if true;
        allow create: if exists(/databases/$(db)/documents/public/$(token))
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string && request.resource.data.data.size() < 900000;
        allow delete: if isTeacher();
      }
      // Колесо фортуни: документ = понеділок тижня, лише створення → одна спроба на тиждень
      match /spins/{week} {
        allow read: if true;
        allow create: if exists(/databases/$(db)/documents/public/$(token))
          && week.size() == 10
          && request.resource.data.keys().hasOnly(['prize', 'created'])
          && request.resource.data.prize is int && request.resource.data.prize >= 0 && request.resource.data.prize < 16
          && request.resource.data.created == request.time;
        allow delete: if isTeacher();
      }
      // Відгук про урок: документ = id відмітки «Був», лише створення → одна оцінка на урок
      match /ratings/{id} {
        allow read: if true;
        allow create: if exists(/databases/$(db)/documents/public/$(token))
          && id.size() <= 40
          && request.resource.data.keys().hasOnly(['date', 'stars', 'comment', 'created'])
          && request.resource.data.date is string && request.resource.data.date.size() == 10
          && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && request.resource.data.comment is string && request.resource.data.comment.size() <= 300
          && request.resource.data.created == request.time;
        allow delete: if isTeacher();
      }
      // «Я в мережі»: кабінет учня оновлює час раз на хвилину
      match /presence/{id} {
        allow read: if true;
        allow write: if id == 'me' && exists(/databases/$(db)/documents/public/$(token))
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow delete: if isTeacher();
      }
      // Персонаж учня
      match /avatar/{id} {
        allow read: if true;
        allow write: if id == 'me' && exists(/databases/$(db)/documents/public/$(token))
          && request.resource.data.keys().hasOnly(['kind', 'color', 'head', 'face', 'back'])
          && request.resource.data.kind is string && request.resource.data.kind.size() <= 20
          && request.resource.data.color is string && request.resource.data.color.size() <= 20
          && request.resource.data.head is string && request.resource.data.head.size() <= 20
          && request.resource.data.face is string && request.resource.data.face.size() <= 20
          && request.resource.data.back is string && request.resource.data.back.size() <= 20;
        allow delete: if isTeacher();
      }
    }
    // Викладач бачить усі фото, чати, ДЗ, колесо й персонажі одним списком
    match /{path=**}/subs/{id} { allow read: if isTeacher(); }
    match /{path=**}/spins/{id} { allow read: if isTeacher(); }
    match /{path=**}/avatar/{id} { allow read: if isTeacher(); }
    match /{path=**}/ratings/{id} { allow read: if isTeacher(); }
    match /{path=**}/presence/{id} { allow read: if isTeacher(); }
    // Портфоліо: відкривається за власним кодом (не кодом кабінету), пише лише викладач
    match /portfolio/{pid} {
      allow get: if true;
      allow list, write: if isTeacher();
      match /works/{id} {
        allow read: if true;
        allow write: if isTeacher();
      }
    }
    // Викладач бачить усі фото й чати одним списком
    match /{path=**}/photos/{id} {
      allow read: if isTeacher();
    }
    match /{path=**}/messages/{id} {
      allow read: if isTeacher();
    }
    // Заявки на вільні вікна: створити може будь-хто, бачить лише викладач
    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['date', 'hour', 'name', 'note', 'contact', 'ref', 'type', 'created'])
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.hour is int
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.get('contact', '') is string && request.resource.data.get('contact', '').size() <= 100
        // ref — код запрошення від учня («Приведи друга»)
        && request.resource.data.get('ref', '') is string && request.resource.data.get('ref', '').size() <= 12
        && request.resource.data.type in ['regular', 'once', 'trial'];
      allow read, update, delete: if isTeacher();
    }
    // Учні, абонементи, відвідуваність, оплати, нотатки — тільки викладач
    match /students/{id} { allow read, write: if isTeacher(); }
    match /attendance/{id} { allow read, write: if isTeacher(); }
    match /payments/{id} { allow read, write: if isTeacher(); }
    match /notes/{id} { allow read, write: if isTeacher(); }
  }
}

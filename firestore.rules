rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isTeacher() {
      return request.auth != null && request.auth.token.email == 'ikramoonfeyx@gmail.com';
    }
    // Розклад бачать усі, змінює тільки викладач
    match /lessons/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // Учні, абонементи, відвідуваність — тільки викладач
    match /students/{id} { allow read, write: if isTeacher(); }
    match /attendance/{id} { allow read, write: if isTeacher(); }
  }
}
